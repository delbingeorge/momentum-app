  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:prod": "NODE_ENV=production expo run:android --variant release",
    "ios:prod": "NODE_ENV=production expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "clean": "watchman watch-del-all 2>/dev/null; rm -rf .expo node_modules/.cache \"$TMPDIR\"metro-* \"$TMPDIR\"haste-map-* \"$TMPDIR\"react-* \"$TMPDIR\"expo-*",
    "clean:native": "rm -rf android/build android/app/build android/app/.cxx android/.gradle android/.kotlin ios/build ios/Pods/build ~/Library/Developer/Xcode/DerivedData/Momentum-*",
    "clean:full": "pnpm clean; pnpm clean:native; rm -rf node_modules ios/Pods ios/Podfile.lock && pnpm install && npx pod-install"
  },
  "private": true,
