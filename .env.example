# Supabase project (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client ids (Google Cloud Console → Credentials)
# Web client id is also set in Supabase Auth → Providers → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK key (test_ key for dev; appl_/goog_ per platform for release)
EXPO_PUBLIC_REVENUECAT_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
