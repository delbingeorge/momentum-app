# Single .env for dev AND production (deliberate: identical env in both, so
# dev builds exercise the real Supabase/RevenueCat config).

# Supabase project (Settings → API Keys)
# Use the publishable key (sb_publishable_...), not the legacy anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth client ids (Google Cloud Console → Credentials)
# Web client id is also set in Supabase Auth → Providers → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat PUBLIC SDK keys per platform (dashboard → API keys). Never sk_
# secret keys — EXPO_PUBLIC_ vars ship inside the app binary. The generic key
# is the fallback when a platform key is unset (e.g. test store during setup).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_KEY=
