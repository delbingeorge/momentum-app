# Env layout (Expo CLI loads these automatically by NODE_ENV):
#   .env             — shared vars, both environments (Supabase, Google auth)
#   .env.development — dev-only overrides (RevenueCat test_ key); expo start / debug builds
#   .env.production  — prod-only overrides (RevenueCat appl_/goog_ keys); release builds

# --- .env (shared) ---

# Supabase project (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client ids (Google Cloud Console → Credentials)
# Web client id is also set in Supabase Auth → Providers → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- .env.development ---

# RevenueCat test store key
EXPO_PUBLIC_REVENUECAT_KEY=

# --- .env.production ---

# RevenueCat PUBLIC SDK keys per platform. Never sk_ secret keys —
# EXPO_PUBLIC_ vars ship inside the app binary.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
